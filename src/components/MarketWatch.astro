        <div class="panel-heading">
          <div><span class="panel-kicker">SEC EDGAR / CORPORATE CREDIT</span><h2>{t.debtTitle}</h2><p>{t.debtSub}</p></div>
          <div class="fear-source"><span class:list={{ stale: aiDebt.stale }}>{aiDebt.stale ? t.lastGood : t.daily}</span><a href={aiDebt.sourceUrl} target="_blank" rel="noreferrer">SEC EDGAR ↗</a></div>
        </div>
        {aiDebt.available ? <>
          <div class="debt-summary">
            <div class="debt-total"><span>{t.debtTracked}</span><strong>${debtTotalUsd.toFixed(1)}<small>bn</small></strong><em>{en ? 'Verified USD public notes since 2025' : '2025 年以来已核验美元公开债券'}</em></div>
            <div><span>{t.debtLatest}</span><b>{debtCompanyMap.get(debtLatestEvent?.company)?.name ?? '—'}</b><small>{debtLatestEvent ? `${debtDate(debtLatestEvent)} · ${debtLatestEvent.status === 'pending' ? (en ? 'terms pending' : '等待定价') : `${debtLatestEvent.currency === 'USD' ? '$' : `${debtLatestEvent.currency} `}${Number(debtLatestEvent.amount).toFixed(1)}bn`}` : '—'}</small></div>
            <div><span>{t.debtCompanies}</span><b>{debtCompanies.length}</b><small>{en ? '7 SEC-reporting issuers' : '7 家 SEC 申报公司'}</small></div>
            <div><span>{t.debtScan}</span><b>{debtCheckedAt}</b><small>{en ? 'Offering filings checked daily' : '每日检查债券发行文件'}</small></div>
          </div>

          <div class="debt-company-grid">
            {debtCompanies.map((company) => <section class:list={{ 'debt-company':true, private:!company.cik }} style={`--company-color:${company.color}`}>
              <div class="debt-company-head"><div><strong>{company.name}</strong><span>{company.ticker}</span></div><b>{company.cik ? (company.trackedUsd ? `$${company.trackedUsd.toFixed(1)}bn` : '$0') : '—'}</b></div>
              <div class="debt-company-bar"><i style={`width:${company.trackedUsd / debtMaxCompany * 100}%`}></i></div>
              <p>{!company.cik ? t.debtPrivate : company.events.some((event) => event.status === 'pending') ? (en ? 'New bond offering filed · terms pending' : '已提交新债券发行 · 等待定价') : company.trackedUsd === 0 ? t.debtNoRecent : (en ? `${company.events.length} disclosed event${company.events.length === 1 ? '' : 's'} in scope` : `统计期内 ${company.events.length} 次披露事件`)}</p>
              {company.monitor?.latest ? <a href={company.monitor.latest.sourceUrl} target="_blank" rel="noreferrer"><span>{company.monitor.latest.form} · {company.monitor.latest.filedAt}</span><em class:list={{ review:company.monitor.needsReview, excluded:company.monitor.classification === 'excluded' }}>{company.monitor.needsReview ? (en ? 'REVIEW' : '待核验') : company.monitor.classification === 'excluded' ? (en ? 'EXCLUDED' : '已排除') : (en ? 'MATCHED' : '已匹配')} ↗</em></a> : <div class="debt-monitor-empty">{company.cik ? (en ? 'No recent offering filing found' : '未发现近期发行文件') : (en ? 'No public EDGAR bond feed' : '无公开 EDGAR 债券数据流')}</div>}
            </section>)}
          </div>

          <div class="debt-timeline">
            <div class="chart-heading"><span>{t.debtTimeline}</span><div>{en ? 'Newest first · USD public notes' : '按日期倒序 · 美元公开债券'}</div></div>
            <div class="debt-table" role="table" aria-label={t.debtTimeline}>
              <div class="debt-row debt-table-head" role="row"><span>{en ? 'Date' : '日期'}</span><span>{en ? 'Issuer' : '发行人'}</span><span>{t.debtAmount}</span><span>{t.debtTranches}</span><span>{t.debtFiling}</span></div>
              {debtEvents.map((event) => <div class="debt-row" role="row">
                <time datetime={event.date}>{debtDate(event)}</time>
                <strong style={`--company-color:${debtCompanyMap.get(event.company)?.color}`}><i></i>{debtCompanyMap.get(event.company)?.name ?? event.company}</strong>
                <b>{event.status === 'pending' ? (en ? 'Pending' : '待定价') : <>{event.currency === 'USD' ? '$' : `${event.currency} `}{Number(event.amount).toFixed(1)}bn</>}</b>
                <div class="debt-tranches">{event.tranches.map((tranche) => <span>{tranche}</span>)}</div>
                <a href={event.sourceUrl} target="_blank" rel="noreferrer">{event.form} ↗</a>
              </div>)}
            </div>
          </div>

          <div class="debt-method">
            <span>01</span><div><strong>{t.debtMethod}</strong><p>{en ? 'Totals include verified principal of public senior-note offerings in USD from 2025 onward. Non-USD bonds, bank loans, leases, project finance, preferred stock and equity are excluded from the headline total.' : '总额仅包含 2025 年以来已核验的美元公开高级债券本金。外币债、银行贷款、租赁、项目融资、优先股和普通股不计入头部总额。'}</p></div>
            <span>02</span><div><strong>{en ? 'Automatic monitoring' : '自动监控方式'}</strong><p>{en ? 'The daily build scans SEC 424B2, 424B5 and FWP filings, plus SpaceX 8-K filings used for its note offering. A new unmatched filing is reviewed before its amount is added, preventing equity, leases or structured notes from being mistaken for company debt.' : '每日构建会扫描 SEC 424B2、424B5 与 FWP 文件，并额外检查 SpaceX 用于披露债券发行的 8-K。新文件核验后才计入，以免把股票、租赁或结构性票据误算成公司债。'}</p></div>
          </div>
        </> : <div class="fear-unavailable">{en ? 'AI debt financing data is temporarily unavailable.' : 'AI 债券融资数据暂时不可用。'}</div>}
      </article>

      <div class="section-label macro-label"><span>05</span><h2>{en ? 'Macro environment' : '宏观环境'}</h2><div></div></div>
      <article class="panel macro-panel">
        <div class="panel-heading">
          <div><span class="panel-kicker">{t.macroKicker}</span><h2>{t.macroTitle}</h2><p>{t.macroSub}</p></div>
          <div class="fear-source"><span class:list={{ stale: macro.stale }}>{macro.stale ? t.lastGood : t.daily}</span><a href={macro.sourceUrl} target="_blank" rel="noreferrer">EUROSTAT ↗</a></div>
        </div>
        <div class="macro-layout">
          <div class="environment-map" role="img" aria-label={`${t.macroTitle}: ${macroLabel}`}>
            <div class="map-zone upper-left"></div><div class="map-zone upper-right"></div><div class="map-zone lower-left"></div><div class="map-zone lower-right"></div>
            <div class="zero-line"></div><div class="target-line"><span>{t.target}</span></div>
            <span class="map-y top">{t.higherInflation}</span><span class="map-y bottom">{t.lowerInflation}</span>
            <span class="map-x left">{t.contraction}</span><span class="map-x right">{t.expansion}</span>
            {macro.available && <div class="environment-dot" style={`left:${macroX}%;top:${macroY}%`}><i></i><strong>EA21</strong></div>}
          </div>
          <div class="macro-readout">
            <span class="readout-label">{t.macroCurrent}</span><h3>{macroLabel}</h3>
            <div class="macro-metrics">
              <div><span>{t.growth}</span><strong>{growthValue === null ? '—' : `${growthValue > 0 ? '+' : ''}${growthValue.toFixed(1)}%`}</strong><small>{t.growthUnit} · {macro.growth?.period ?? '—'}</small></div>
              <div><span>{t.inflation}</span><strong>{inflationValue === null ? '—' : `${inflationValue.toFixed(1)}%`}</strong><small>{t.inflationUnit} · {macro.inflation?.period ?? '—'}</small></div>
            </div>
            <div class="source-list">
              <a href={macro.sourceUrl} target="_blank" rel="noreferrer"><span>GDP · namq_10_gdp</span><em>Eurostat ↗</em></a>
              <a href={macro.inflationSourceUrl} target="_blank" rel="noreferrer"><span>HICP · prc_hicp_minr</span><em>Eurostat ↗</em></a>
            </div>
          </div>
        </div>
        <section class="macro-fx-section">
          <div class="panel-heading">
            <div><span class="panel-kicker">FOREIGN EXCHANGE / EURUSD</span><h2>{t.fxTitle}</h2><p>{t.fxSub}</p></div>
            <div class="fear-source"><span class:list={{ stale: eurUsd.stale }}>{eurUsd.stale ? t.lastGood : t.daily}</span><a href={eurUsd.sourceUrl} target="_blank" rel="noreferrer">EUR/USD ↗</a></div>
          </div>
          <div class="fx-layout">
            <div class="fx-readout">
              <span>{t.currentRate} · {eurUsd.date ?? '—'}</span>
              <strong>{eurUsdValue?.toFixed(4) ?? '—'}</strong>
              <small>1 EUR = {eurUsdValue?.toFixed(4) ?? '—'} USD</small>
              <div class="fx-stats">
                <div><span>{t.dailyChange}</span><b class:list={{ positive: Number(eurUsd.dailyChange) >= 0, negative: Number(eurUsd.dailyChange) < 0 }}>{Number(eurUsd.dailyChange) >= 0 ? '+' : ''}{Number(eurUsd.dailyChange).toFixed(2)}%</b></div>
                <div><span>{t.yearChange}</span><b class:list={{ positive: Number(eurUsd.oneYearChange) >= 0, negative: Number(eurUsd.oneYearChange) < 0 }}>{Number(eurUsd.oneYearChange) >= 0 ? '+' : ''}{Number(eurUsd.oneYearChange).toFixed(2)}%</b></div>
                <div><span>{t.yearRange}</span><b>{Number(eurUsd.yearLow).toFixed(4)}–{Number(eurUsd.yearHigh).toFixed(4)}</b></div>
              </div>
            </div>
            <div class="fx-chart">
              <div class="chart-heading"><span>{t.fxHistory}</span><div><i class="legend-fx"></i>EUR/USD</div></div>
              {eurUsdPath ? <div class="axis-chart-shell fx-axis-shell"><div class="value-axis">{eurUsdYTicks.map((value) => <span>{value.toFixed(2)}</span>)}</div><div class="axis-plot"><div class="interactive-chart" data-chart="fx" data-points={JSON.stringify(eurUsdHistory)} data-y-min={eurUsdMin} data-y-max={eurUsdMax} tabindex="0"><svg viewBox={`0 0 ${eurUsdWidth} ${eurUsdHeight}`} preserveAspectRatio="none" role="img" aria-label={en ? 'Interactive one-year EUR/USD history' : '可交互的近一年欧元兑美元走势'}><defs><linearGradient id="fx-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3867d6" stop-opacity=".22"/><stop offset="1" stop-color="#3867d6" stop-opacity="0"/></linearGradient></defs>{eurUsdYTicks.map((value) => <line class="axis-grid" x1="0" y1={eurUsdHeight - (value - eurUsdMin) / (eurUsdMax - eurUsdMin) * eurUsdHeight} x2={eurUsdWidth} y2={eurUsdHeight - (value - eurUsdMin) / (eurUsdMax - eurUsdMin) * eurUsdHeight}/>) }<path class="fx-area" d={eurUsdArea}/><path class="fx-line" d={eurUsdPath}/></svg><div class="chart-crosshair"></div><div class="chart-dot primary"></div><div class="chart-tooltip" role="status"></div></div><div class="chart-axis detailed-axis">{eurUsdXTicks.map((point) => <span>{point.date.slice(0,7)}</span>)}</div></div></div> : <div class="fear-unavailable">{en ? 'EUR/USD data is temporarily unavailable.' : '欧元兑美元数据暂时不可用。'}</div>}
            </div>
          </div>
          <p class="fear-caption">{en ? 'Source: delayed daily EUR/USD closes. One euro is quoted in U.S. dollars; the series refreshes with the daily data build.' : '数据来源：EUR/USD 延迟日收盘数据。报价表示 1 欧元可兑换的美元数量，并随每日数据构建自动更新。'}</p>
        </section>
        <div class="method-grid">
          <div><span>01</span><h3>{t.methodTitle}</h3><p>{t.method}</p></div>
          <div><span>02</span><h3>{t.automationTitle}</h3><p>{t.automation}</p></div>
        </div>
      </article>
    </main>

    <footer class="watch-footer"><span>{t.footer}</span><span>{t.legal}</span></footer>

    <script is:inline>
      (() => {
        const lang = document.documentElement.lang.startsWith('zh') ? 'zh-CN' : 'en-GB';
        const zh = lang === 'zh-CN';
        const number = (value, digits = 1) => Number(value).toLocaleString(lang, { minimumFractionDigits: digits, maximumFractionDigits: digits });
        const signed = (value, digits = 2) => `${Number(value) >= 0 ? '+' : ''}${number(value, digits)}%`;
        const dateLabel = (value) => {
          if (!value) return '—';
          if (/^\d{4}-\d{2}$/.test(value)) return value;
          const parsed = new Date(value.length === 10 ? `${value}T00:00:00Z` : value);
          return Number.isNaN(parsed.valueOf()) ? value : new Intl.DateTimeFormat(lang, { year:'numeric', month:'2-digit', day:'2-digit', timeZone:'UTC' }).format(parsed);
        };
        const makeTooltip = (tooltip, title, rows) => {
          tooltip.replaceChildren();
          const heading = document.createElement('strong');
          heading.textContent = title;
          tooltip.append(heading);
          rows.forEach(([label, value, tone]) => {
            const row = document.createElement('span');
            const key = document.createElement('i');
            const result = document.createElement('b');
            key.textContent = label;
            result.textContent = value;
            if (tone) result.className = tone;
            row.append(key, result);
            tooltip.append(row);
          });
        };
        document.querySelectorAll('.interactive-chart').forEach((chart) => {
          const points = JSON.parse(chart.dataset.points || '[]');
          if (!points.length) return;
          const type = chart.dataset.chart;
          const crosshair = chart.querySelector('.chart-crosshair');
          const primary = chart.querySelector('.chart-dot.primary');
          const secondary = chart.querySelector('.chart-dot.secondary');
          const tertiary = chart.querySelector('.chart-dot.tertiary');
          const tooltip = chart.querySelector('.chart-tooltip');
          const valueY = (value, min, max, height) => height - (Math.min(max, Math.max(min, Number(value))) - min) / (max - min) * height;
          const render = (index) => {
            index = Math.max(0, Math.min(points.length - 1, index));
            chart.dataset.activeIndex = String(index);
            const point = points[index];
            const rect = chart.getBoundingClientRect();
            const x = points.length > 1 ? index / (points.length - 1) * rect.width : rect.width / 2;
            let y = rect.height / 2;
            let secondY = null;
            let thirdY = null;
            let title = point.date || point.period || '—';
            let rows = [];
            let primaryColor = '#0071e3';
            if (type === 'fear') {
              y = valueY(point.value, 0, 100, rect.height);
              rows = [[zh ? '指数' : 'Index', number(point.value, 1)]];
              primaryColor = '#d98532';
            } else if (type === 'breadth') {
              const range = Number(chart.dataset.spRange || 1.5);
              y = valueY(point.score, 0, 100, rect.height);
              secondY = valueY(point.sp500Change, -range, range, rect.height);
              rows = [
                [zh ? '广度得分' : 'Breadth score', number(point.score, 1)],
                ['S&P 500', signed(point.sp500Change, 2), Number(point.sp500Change) >= 0 ? 'up' : 'down'],
                [zh ? '上涨 / 下跌' : 'Advance / decline', `${point.advancers} / ${point.decliners}`],
              ];
              primaryColor = '#21966f';
            } else if (type === 'cape') {
              y = valueY(point.value, Number(chart.dataset.yMin), Number(chart.dataset.yMax), rect.height);
              rows = [['CAPE', number(point.value, 2)]];
            } else if (type === 'gold') {
              y = valueY(point.ratio, Number(chart.dataset.yMin), Number(chart.dataset.yMax), rect.height);
              rows = [
                [zh ? '比值' : 'Ratio', number(point.ratio, 2)],
                [zh ? '黄金' : 'Gold', `$${number(point.goldPrice, 2)}`],
                [zh ? '美债总额' : 'U.S. debt', `$${number(point.debtTrillions, 2)} tn`],
              ];
              primaryColor = '#cf862c';
            } else if (type === 'fx') {
              y = valueY(point.value, Number(chart.dataset.yMin), Number(chart.dataset.yMax), rect.height);
              rows = [[zh ? '欧元兑美元' : 'EUR/USD', number(point.value, 4)]];
              primaryColor = '#3867d6';
            } else if (type === 'index-ytd') {
              const min = Number(chart.dataset.yMin);
              const max = Number(chart.dataset.yMax);
              y = valueY(point.shanghai, min, max, rect.height);
              secondY = valueY(point.sp500, min, max, rect.height);
              thirdY = valueY(point.nasdaq100, min, max, rect.height);
              rows = [
                [zh ? '上证指数' : 'Shanghai', signed(Number(point.shanghai) - 100, 2), Number(point.shanghai) >= 100 ? 'up' : 'down'],
                ['S&P 500', signed(Number(point.sp500) - 100, 2), Number(point.sp500) >= 100 ? 'up' : 'down'],
                [zh ? '纳斯达克 100' : 'Nasdaq-100', signed(Number(point.nasdaq100) - 100, 2), Number(point.nasdaq100) >= 100 ? 'up' : 'down'],
              ];
              primaryColor = '#d34d63';
            }
            title = dateLabel(title);
            crosshair.style.left = `${x}px`;
            primary.style.left = `${x}px`;
            primary.style.top = `${y}px`;
            primary.style.background = primaryColor;
            if (secondary && secondY !== null) {
              secondary.style.left = `${x}px`;
              secondary.style.top = `${secondY}px`;
              secondary.style.background = type === 'index-ytd' ? '#21966f' : '';
            }
            if (tertiary && thirdY !== null) {
              tertiary.style.left = `${x}px`;
              tertiary.style.top = `${thirdY}px`;
              tertiary.style.background = '#3867d6';
            }
            makeTooltip(tooltip, title, rows);
            chart.classList.add('is-active');
            const tooltipWidth = tooltip.offsetWidth;
            const left = x > rect.width * .62 ? x - tooltipWidth - 12 : x + 12;
            tooltip.style.left = `${Math.max(4, Math.min(rect.width - tooltipWidth - 4, left))}px`;
            tooltip.style.top = `${Math.max(4, Math.min(rect.height - tooltip.offsetHeight - 4, y - 28))}px`;
          };
          chart.addEventListener('pointermove', (event) => {
            const rect = chart.getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
            render(Math.round(ratio * (points.length - 1)));
          });
          chart.addEventListener('pointerleave', () => chart.classList.remove('is-active'));
          chart.addEventListener('focus', () => render(Number(chart.dataset.activeIndex ?? points.length - 1)));
          chart.addEventListener('blur', () => chart.classList.remove('is-active'));
          chart.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const current = Number(chart.dataset.activeIndex ?? points.length - 1);
            render(current + (event.key === 'ArrowRight' ? 1 : -1));
          });
        });
        document.querySelectorAll('[data-range-tabs]').forEach((tabs) => {
          tabs.addEventListener('click', (event) => {
            const button = event.target.closest('button[data-range]');
            if (!button) return;
            const container = tabs.closest('.fear-history, .gold-debt-chart');
            if (!container) return;
            tabs.querySelectorAll('button[data-range]').forEach((item) => {
              const selected = item === button;
              item.classList.toggle('active', selected);
              item.setAttribute('aria-pressed', selected ? 'true' : 'false');
            });
            container.querySelectorAll('[data-range-panel]').forEach((panel) => {
              const selected = panel.dataset.rangePanel === button.dataset.range;
              panel.hidden = !selected;
              if (!selected) panel.querySelector('.interactive-chart')?.classList.remove('is-active');
            });
          });
        });
      })();
    </script>

  </body>
</html>

<style is:global>
  :root{--watch-bg:#f5f5f3;--watch-panel:#ffffff;--watch-panel-2:#f0f6fc;--watch-line:#dbe3eb;--watch-text:#102d49;--watch-muted:#68788a;--watch-cyan:#0071e3;--watch-blue:#3867d6;--watch-green:#21966f;--watch-amber:#cf862c;--watch-red:#d34d63;--watch-violet:#8253bb}
  .watch-page{background:var(--watch-bg);color:var(--watch-text);color-scheme:light;scroll-padding-top:82px}
  .watch-body{margin:0;background:radial-gradient(circle at 74% -10%,rgba(0,113,227,.11),transparent 34%),linear-gradient(#f8fafc,#f5f5f3 580px);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;min-height:100vh}
  .watch-body *{box-sizing:border-box}.watch-body a{color:inherit;text-decoration:none}.watch-skip{position:fixed;left:20px;top:-100px;z-index:50;background:#102d49;color:#fff;padding:12px 16px}.watch-skip:focus{top:10px}
  .watch-header{position:sticky;top:0;z-index:20;border-bottom:1px solid rgba(16,45,73,.11);background:rgba(255,255,255,.9);backdrop-filter:blur(18px)}
  .watch-nav{height:72px;width:min(1440px,calc(100% - 48px));margin:auto;display:flex;align-items:center;justify-content:space-between}.watch-brand{display:flex;align-items:center;gap:12px;font-size:20px;font-weight:750;letter-spacing:-.6px}.watch-brand img{object-fit:contain}.watch-brand small{display:block;color:var(--watch-muted);font-size:8px;letter-spacing:2.2px;margin-top:2px}.watch-nav-actions{display:flex;align-items:center;gap:28px;font-size:12px;color:var(--watch-muted)}.watch-nav-actions a:hover{color:var(--watch-text)}.language-switch{border:1px solid var(--watch-line);border-radius:999px;padding:9px 13px}
