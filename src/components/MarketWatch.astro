---
import '../styles/global.css';
import marketData from '../data/market-watch.json';

const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const canonical = `https://acfc-aachen.github.io${en ? '/en/market-watch/' : '/market-watch/'}`;
const cnn = marketData.cnn ?? {};
const macro = marketData.macro ?? {};
const shillerCape = marketData.shillerCape ?? {};
const breadth = marketData.breadth ?? {};
const goldDebt = marketData.goldDebt ?? {};
const eurUsd = marketData.eurUsd ?? {};
const qqq = marketData.qqq ?? {};
const indexYtd = marketData.indexYtd ?? {};
const aiDebt = marketData.aiDebt ?? {};
const t = en ? {
  home:'Back to ACFC', language:'中文', eyebrow:'ACFC / VERIFIED DATA', title:'Market Watch',
  subtitle:'A focused view of sentiment, valuation, breadth and the macro environment — using verifiable data.',
  online:'DAILY CHECK ACTIVE', updated:'Sources are checked every day', sentiment:'Market sentiment', valuation:'Market valuation', breadth:'Market breadth', pulse:'Market pulse', valuationCross:'Valuation & cross-asset ratio',
  fearTitle:'Fear & Greed Index', fearSub:'CNN market sentiment · latest available reading', daily:'DAILY DATA', lastGood:'LAST GOOD DATA',
  history:'Sentiment history', asOf:'As of', extremeFear:'Extreme fear', extremeGreed:'Extreme greed',
  macroKicker:'EUROSTAT / EURO AREA', macroTitle:'Market environment map', macroSub:'Real growth and inflation data · not a forecast',
  macroCurrent:'Current environment', growth:'Real GDP growth', inflation:'HICP inflation', growthUnit:'quarter on quarter', inflationUnit:'year on year',
  contraction:'CONTRACTION', expansion:'EXPANSION', lowerInflation:'LOWER INFLATION', higherInflation:'HIGHER INFLATION', target:'ECB 2% reference',
  methodTitle:'How the map works', method:'The horizontal axis is seasonally and calendar-adjusted real GDP growth versus the previous quarter. The vertical axis is annual HICP inflation. The dot moves only when Eurostat publishes or revises an observation.',
  automationTitle:'Automatic updates', automation:'GitHub Actions checks every source daily. New observations are deployed automatically; if a source is temporarily unavailable, the last successful reading remains visible and is marked stale.',
  capeTitle:'Shiller CAPE', capeSub:'S&P 500 cyclically adjusted valuation · monthly data', capeHistory:'20-year valuation history', capeAverage:'Long-term average', capeMedian:'Long-term median', capePercentile:'Historical percentile',
  breadthTitle:'S&P 500 market breadth', breadthSub:'Advancing and declining constituent securities · daily close', breadthHistory:'Recent 60 sessions', advancers:'Advancing', decliners:'Declining', unchanged:'Unchanged', coverage:'Coverage',
  goldDebtTitle:'Gold price / U.S. debt', goldDebtSub:'COMEX gold price relative to total U.S. public debt', goldDebtHistory:'Gold/debt ratio history', goldPrice:'Gold price', usDebt:'Total U.S. debt', oneYearChange:'One-year change', ratioUnit:'USD/oz per USD 1tn debt',
  qqqTitle:'QQQ daily return calendar', qqqSub:'Nasdaq-100 ETF · year-to-date adjusted-close returns', qqqDistribution:'Daily return distribution', tradingDays:'Trading days', positiveRate:'Positive-day rate', averageDaily:'Average daily return', bestDay:'Best day', worstDay:'Worst day',
  indexTitle:'Three-index YTD comparison', indexSub:'Shanghai Composite · S&P 500 · Nasdaq-100, rebased to 100', indexHistory:'Normalized YTD performance', indexBase:'Previous-year final close = 100',
  debtTitle:'AI debt financing monitor', debtSub:'Verified corporate bond issuance events linked to the AI infrastructure cycle', debtTracked:'Tracked USD issuance', debtLatest:'Latest verified issue', debtCompanies:'Companies monitored', debtTimeline:'Issuance timeline', debtAmount:'Principal', debtTranches:'Tranches / maturities', debtFiling:'Primary filing', debtScan:'SEC filing scan', debtNoRecent:'No recent public issue', debtPrivate:'Private · limited disclosure', debtMethod:'Coverage methodology',
  fxTitle:'EUR/USD trend', fxSub:'Euro exchange rate against the U.S. dollar · delayed daily close', currentRate:'Current rate', dailyChange:'Daily change', yearChange:'One-year change', yearRange:'52-week range', fxHistory:'One-year EUR/USD history',
  source:'Source', dataPeriod:'Data period', footer:'ACFC Market Watch · Verified public data', legal:'Not investment advice',
} : {
  home:'返回 ACFC', language:'EN', eyebrow:'ACFC / VERIFIED DATA', title:'市场监控',
  subtitle:'用可核验数据观察市场情绪、估值、广度与宏观经济环境。',
  online:'每日检查已启用', updated:'系统每天检查数据源', sentiment:'市场情绪', valuation:'市场估值', breadth:'市场广度', pulse:'市场脉搏', valuationCross:'估值与跨资产比值',
  fearTitle:'恐慌与贪婪指数', fearSub:'CNN 市场情绪 · 最近可用读数', daily:'每日数据', lastGood:'最近有效数据',
  history:'情绪历史走势', asOf:'数据时间', extremeFear:'极度恐慌', extremeGreed:'极度贪婪',
  macroKicker:'EUROSTAT / EURO AREA', macroTitle:'市场环境地图', macroSub:'真实增长与通胀数据 · 不是预测模型',
  macroCurrent:'当前环境', growth:'实际 GDP 增长', inflation:'HICP 通胀', growthUnit:'环比', inflationUnit:'同比',
  contraction:'经济收缩', expansion:'经济扩张', lowerInflation:'低通胀', higherInflation:'高通胀', target:'ECB 2% 参考线',
  methodTitle:'地图如何计算', method:'横轴为经季节和日历调整后的实际 GDP 季度环比；纵轴为 HICP 年度通胀率。只有 Eurostat 发布或修订数据时，地图位置才会变化。',
  automationTitle:'如何保证自动更新', automation:'GitHub Actions 每天检查全部数据源。发现新数据后自动重新发布；如果数据源暂时不可用，则保留最近一次成功数据并标记为过期。',
  capeTitle:'席勒市盈率', capeSub:'标普 500 周期调整估值 · 月度数据', capeHistory:'近 20 年估值历史', capeAverage:'长期均值', capeMedian:'长期中位数', capePercentile:'历史分位',
  breadthTitle:'标普 500 市场广度', breadthSub:'成分证券上涨与下跌家数 · 每日收盘', breadthHistory:'近 60 个交易日', advancers:'上涨', decliners:'下跌', unchanged:'平盘', coverage:'覆盖',
  goldDebtTitle:'黄金价格与美债总量的比值', goldDebtSub:'COMEX 黄金价格相对于美国公共债务总额', goldDebtHistory:'黄金/美债比值历史', goldPrice:'黄金价格', usDebt:'美国债务总额', oneYearChange:'一年变化', ratioUnit:'美元/盎司 ÷ 每万亿美元债务',
  qqqTitle:'QQQ 每日涨跌日历', qqqSub:'纳斯达克 100 ETF · 年初至今复权收盘日收益', qqqDistribution:'每日收益分布', tradingDays:'交易日', positiveRate:'上涨日占比', averageDaily:'日均涨跌', bestDay:'最佳单日', worstDay:'最差单日',
  indexTitle:'三大指数 YTD 对比', indexSub:'上证指数 · 标普 500 · 纳斯达克 100，统一归一化为 100', indexHistory:'年内归一化走势', indexBase:'以上一年最后收盘日为 100',
  debtTitle:'AI 债券融资监控', debtSub:'追踪 AI 基础设施周期中的公司公开债券发行事件', debtTracked:'已追踪美元发行额', debtLatest:'最近核验发行', debtCompanies:'监控公司', debtTimeline:'债券发行时间线', debtAmount:'发行本金', debtTranches:'期限与票息', debtFiling:'原始文件', debtScan:'SEC 文件扫描', debtNoRecent:'近期无公开新发行', debtPrivate:'私营公司 · 披露有限', debtMethod:'统计口径',
  fxTitle:'欧元兑美元走势', fxSub:'欧元相对美元汇率 · 延迟日收盘数据', currentRate:'当前汇率', dailyChange:'当日变化', yearChange:'一年变化', yearRange:'52 周区间', fxHistory:'近一年 EUR/USD 走势',
  source:'来源', dataPeriod:'统计期', footer:'ACFC Market Watch · 可核验公开数据', legal:'不构成投资建议',
};

const fearScore = cnn.available && cnn.score !== null ? Number(cnn.score) : null;
const fearRatingLabels: Record<string,string> = en ? {
  'extreme fear':'Extreme fear', fear:'Fear', neutral:'Neutral', greed:'Greed', 'extreme greed':'Extreme greed',
} : {
  'extreme fear':'极度恐慌', fear:'恐慌', neutral:'中性', greed:'贪婪', 'extreme greed':'极度贪婪',
};
const fearRating = fearRatingLabels[cnn.rating] ?? (en ? 'Unavailable' : '暂无数据');
const fearColor = fearScore === null ? '#8a96a6' : fearScore < 25 ? '#d84e66' : fearScore < 45 ? '#d98532' : fearScore < 55 ? '#7b8797' : fearScore < 75 ? '#3a9f78' : '#16865c';
const fearAllHistory = cnn.history ?? [];
const fearWidth = 620;
const fearHeight = 150;
const fearRangeCharts = [
  { id:'60d', label: en ? '60D' : '60日', points:fearAllHistory.slice(-60) },
  { id:'6m', label: en ? '6M' : '6个月', points:fearAllHistory.slice(-130) },
  { id:'1y', label: en ? '1Y' : '1年', points:fearAllHistory.slice(-260) },
].map((range) => {
  const path = range.points.map((point, index) => {
    const x = range.points.length > 1 ? index / (range.points.length - 1) * fearWidth : 0;
    const y = fearHeight - Number(point.value) / 100 * fearHeight;
    return `${index === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }).join(' ');
  return { ...range, path, area: path ? `${path} L${fearWidth} ${fearHeight} L0 ${fearHeight} Z` : '' };
});
const fearAsOf = cnn.asOf ? new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { dateStyle:'medium', timeStyle:'short', timeZone:'Europe/Berlin' }).format(new Date(cnn.asOf)) : '—';
const comparison = en ? [
  ['Previous close',cnn.previousClose],['One week ago',cnn.previousWeek],['One month ago',cnn.previousMonth],['One year ago',cnn.previousYear],
] : [
  ['前一收盘日',cnn.previousClose],['一周前',cnn.previousWeek],['一个月前',cnn.previousMonth],['一年前',cnn.previousYear],
];
const linePath = (points, key, width, height, min, max) => points.map((point, index) => {
  const x = points.length > 1 ? index / (points.length - 1) * width : 0;
  const raw = Number(point[key]);
  const y = height - (Math.min(max, Math.max(min, raw)) - min) / (max - min) * height;
  return `${index === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join(' ');
const capeValue = shillerCape.available ? Number(shillerCape.value) : null;
const capeHistory = (shillerCape.history ?? []).slice(-240);
const capeWidth = 720;
const capeHeight = 180;
const capeMax = Math.max(50, Math.ceil(Math.max(...capeHistory.map((point) => Number(point.value) || 0)) / 10) * 10);
const capePath = linePath(capeHistory, 'value', capeWidth, capeHeight, 0, capeMax);
const capeArea = capePath ? `${capePath} L${capeWidth} ${capeHeight} L0 ${capeHeight} Z` : '';
const capeAverageY = capeHeight - Number(shillerCape.longTermAverage ?? 0) / capeMax * capeHeight;
const capeYTicks = Array.from({ length: 6 }, (_, index) => capeMax - index * capeMax / 5);
const capeLabel = capeValue === null ? (en ? 'Unavailable' : '暂无数据')
  : Number(shillerCape.historicalPercentile) >= 90 ? (en ? 'Historically elevated' : '历史高估值区间')
  : Number(shillerCape.historicalPercentile) >= 75 ? (en ? 'Above historical norms' : '高于历史常态')
  : Number(shillerCape.historicalPercentile) >= 25 ? (en ? 'Within historical range' : '历史常态区间')
  : (en ? 'Historically subdued' : '历史低估值区间');
const breadthScore = breadth.available ? Number(breadth.score) : null;
const breadthColor = breadthScore === null ? '#8a96a6' : breadthScore >= 55 ? '#21966f' : breadthScore >= 45 ? '#7b8797' : '#d84e66';
const breadthLabel = breadthScore === null ? (en ? 'Unavailable' : '暂无数据')
  : breadthScore >= 65 ? (en ? 'Broad strength' : '广泛上涨')
  : breadthScore >= 55 ? (en ? 'Positive breadth' : '广度偏强')
  : breadthScore >= 45 ? (en ? 'Balanced' : '多空均衡')
  : breadthScore >= 35 ? (en ? 'Weak breadth' : '广度偏弱')
  : (en ? 'Broad weakness' : '广泛下跌');
const breadthHistory = (breadth.history ?? []).slice(-60);
const breadthWidth = 720;
const breadthHeight = 190;
const breadthPath = linePath(breadthHistory, 'score', breadthWidth, breadthHeight, 0, 100);
const spRange = Math.max(1.5, ...breadthHistory.map((point) => Math.abs(Number(point.sp500Change) || 0)));
const spPath = linePath(breadthHistory, 'sp500Change', breadthWidth, breadthHeight, -spRange, spRange);
const spChange = breadth.available ? Number(breadth.sp500Change) : null;
const goldDebtValue = goldDebt.available ? Number(goldDebt.ratio) : null;
const goldDebtAllHistory = goldDebt.history ?? [];
const goldDebtWidth = 720;
const goldDebtHeight = 180;
const axisTicks = (points, count = 5) => Array.from({ length: count }, (_, index) => points[Math.round(index * (points.length - 1) / (count - 1))]).filter(Boolean);
const capeXTicks = axisTicks(capeHistory);
const goldDebtRangeCharts = [
  { id:'5y', label: en ? '5Y' : '5年', points:goldDebtAllHistory.slice(-60) },
  { id:'10y', label: en ? '10Y' : '10年', points:goldDebtAllHistory.slice(-120) },
  { id:'20y', label: en ? '20Y' : '20年', points:goldDebtAllHistory.slice(-240) },
].map((range) => {
  const values = range.points.map((point) => Number(point.ratio)).filter(Number.isFinite);
  const rawMin = values.length ? Math.min(...values) : 0;
  const rawMax = values.length ? Math.max(...values) : 100;
  const step = Math.max(5, Math.ceil((rawMax - rawMin) / 4 / 5) * 5);
  const min = Math.max(0, Math.floor(rawMin / step) * step);
  const max = Math.max(min + step, Math.ceil(rawMax / step) * step);
  const yTicks = Array.from({ length: Math.round((max - min) / step) + 1 }, (_, index) => max - index * step);
  const path = linePath(range.points, 'ratio', goldDebtWidth, goldDebtHeight, min, max);
  return { ...range, min, max, yTicks, path, area:path ? `${path} L${goldDebtWidth} ${goldDebtHeight} L0 ${goldDebtHeight} Z` : '', xTicks:axisTicks(range.points) };
});
const eurUsdValue = eurUsd.available ? Number(eurUsd.value) : null;
const eurUsdHistory = (eurUsd.history ?? []).slice(-260);
const eurUsdWidth = 920;
const eurUsdHeight = 190;
const eurUsdValues = eurUsdHistory.map((point) => Number(point.value)).filter(Number.isFinite);
const eurUsdRawMin = eurUsdValues.length ? Math.min(...eurUsdValues) : 1;
const eurUsdRawMax = eurUsdValues.length ? Math.max(...eurUsdValues) : 1.2;
const eurUsdStep = Math.max(.01, Math.ceil((eurUsdRawMax - eurUsdRawMin) / 4 * 100) / 100);
const eurUsdMin = Math.floor(eurUsdRawMin / eurUsdStep) * eurUsdStep;
const eurUsdMax = Math.ceil(eurUsdRawMax / eurUsdStep) * eurUsdStep;
const eurUsdYTicks = Array.from({ length: Math.round((eurUsdMax - eurUsdMin) / eurUsdStep) + 1 }, (_, index) => eurUsdMax - index * eurUsdStep);
const eurUsdPath = linePath(eurUsdHistory, 'value', eurUsdWidth, eurUsdHeight, eurUsdMin, eurUsdMax);
const eurUsdArea = eurUsdPath ? `${eurUsdPath} L${eurUsdWidth} ${eurUsdHeight} L0 ${eurUsdHeight} Z` : '';
const eurUsdXTicks = axisTicks(eurUsdHistory);
const qqqYear = Number(qqq.year) || new Date().getUTCFullYear();
const qqqHistory = qqq.history ?? [];
const qqqByDate = new Map(qqqHistory.map((point) => [point.date, point]));
const qqqMonths = Array.from({ length:12 }, (_, month) => {
  const days = new Date(Date.UTC(qqqYear, month + 1, 0)).getUTCDate();
  const leading = (new Date(Date.UTC(qqqYear, month, 1)).getUTCDay() + 6) % 7;
  const cells = Array.from({ length:leading }, () => null);
  for (let day = 1; day <= days; day += 1) {
    const date = `${qqqYear}-${String(month + 1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
    const point = qqqByDate.get(date);
    cells.push({ date, day, point, strength:point ? Math.min(1, .18 + Math.abs(Number(point.change)) / 3 * .82) : 0 });
  }
  return { month, label:new Intl.DateTimeFormat(en ? 'en-US' : 'zh-CN', { month:'long', timeZone:'UTC' }).format(new Date(Date.UTC(qqqYear, month, 1))), cells };
});
const qqqTradingDays = qqqHistory.length;
const qqqPositiveRate = qqqTradingDays ? Number(qqq.positiveDays ?? 0) / qqqTradingDays * 100 : null;
const qqqBins = (qqq.bins ?? []).map((bin) => ({
  ...bin,
  label:({ down2:en ? '< −2%' : '< −2%', down1:'−2% – −1%', down0:'−1% – 0%', up0:'0% – +1%', up1:'+1% – +2%', up2:en ? '> +2%' : '> +2%' })[bin.id] ?? bin.id,
}));
const qqqBinMax = Math.max(1, ...qqqBins.map((bin) => Number(bin.count) || 0));
const indexYtdHistory = indexYtd.history ?? [];
const indexYtdWidth = 920;
const indexYtdHeight = 220;
const indexYtdValues = indexYtdHistory.flatMap((point) => ['shanghai','sp500','nasdaq100'].map((key) => Number(point[key]))).filter(Number.isFinite);
const indexYtdRawMin = indexYtdValues.length ? Math.min(...indexYtdValues) : 90;
const indexYtdRawMax = indexYtdValues.length ? Math.max(...indexYtdValues) : 110;
const indexYtdMin = Math.floor((indexYtdRawMin - 2) / 5) * 5;
const indexYtdMax = Math.max(indexYtdMin + 10, Math.ceil((indexYtdRawMax + 2) / 5) * 5);
const indexYtdTicks = Array.from({ length:Math.round((indexYtdMax - indexYtdMin) / 5) + 1 }, (_, index) => indexYtdMax - index * 5);
const indexYtdXTicks = axisTicks(indexYtdHistory);
const indexPaths = {
  shanghai:linePath(indexYtdHistory, 'shanghai', indexYtdWidth, indexYtdHeight, indexYtdMin, indexYtdMax),
  sp500:linePath(indexYtdHistory, 'sp500', indexYtdWidth, indexYtdHeight, indexYtdMin, indexYtdMax),
  nasdaq100:linePath(indexYtdHistory, 'nasdaq100', indexYtdWidth, indexYtdHeight, indexYtdMin, indexYtdMax),
};
const indexSeries = (indexYtd.series ?? []).map((series) => ({
  ...series,
  displayName:({ shanghai:en ? 'Shanghai Composite' : '上证指数', sp500:'S&P 500', nasdaq100:en ? 'Nasdaq-100' : '纳斯达克 100' })[series.id] ?? series.name,
  color:({ shanghai:'#d34d63', sp500:'#21966f', nasdaq100:'#3867d6' })[series.id] ?? '#68788a',
}));
const debtEvents = aiDebt.events ?? [];
const debtCompanies = (aiDebt.companies ?? []).map((company) => {
  const events = debtEvents.filter((event) => event.company === company.id && event.currency === 'USD');
  const pricedEvents = events.filter((event) => Number.isFinite(Number(event.amount)) && Number(event.amount) > 0);
  return { ...company, events, pricedEvents, trackedUsd:pricedEvents.reduce((sum, event) => sum + Number(event.amount), 0) };
});
const debtCompanyMap = new Map(debtCompanies.map((company) => [company.id, company]));
const debtTotalUsd = debtCompanies.reduce((sum, company) => sum + company.trackedUsd, 0);
const debtMaxCompany = Math.max(1, ...debtCompanies.map((company) => company.trackedUsd));
const debtLatestEvent = debtEvents[0];
const debtCheckedAt = aiDebt.checkedAt ? new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { dateStyle:'medium', timeStyle:'short', timeZone:'Europe/Berlin' }).format(new Date(aiDebt.checkedAt)) : '—';
const debtDate = (event) => event.datePrecision === 'month'
  ? new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { year:'numeric', month:'short', timeZone:'UTC' }).format(new Date(`${event.date}T00:00:00Z`))
  : new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { year:'numeric', month:'2-digit', day:'2-digit', timeZone:'UTC' }).format(new Date(`${event.date}T00:00:00Z`));
const growthValue = macro.available ? Number(macro.growth?.value) : null;
const inflationValue = macro.available ? Number(macro.inflation?.value) : null;
const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
const macroX = growthValue === null ? 50 : clamp((growthValue + 1) / 2 * 100, 5, 95);
const macroY = inflationValue === null ? 50 : clamp((1 - inflationValue / 6) * 100, 5, 95);
const macroLabel = growthValue === null || inflationValue === null ? (en ? 'Data unavailable' : '暂无数据')
  : growthValue >= 0 && inflationValue > 2 ? (en ? 'Expansion · inflation above target' : '经济扩张 · 通胀高于目标')
  : growthValue >= 0 ? (en ? 'Expansion · lower inflation' : '经济扩张 · 通胀较低')
  : inflationValue > 2 ? (en ? 'Contraction · inflation above target' : '经济收缩 · 通胀高于目标')
  : (en ? 'Contraction · lower inflation' : '经济收缩 · 通胀较低');
---
<!doctype html>
<html lang={en ? 'en' : 'zh-CN'} class="watch-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en ? 'Market Watch — ACFC' : '市场监控 Market Watch — ACFC'}</title>
    <meta name="description" content={t.subtitle} />
    <meta name="theme-color" content="#f5f5f3" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href="https://acfc-aachen.github.io/market-watch/" />
    <link rel="alternate" hreflang="en" href="https://acfc-aachen.github.io/en/market-watch/" />
    <link rel="alternate" hreflang="x-default" href="https://acfc-aachen.github.io/market-watch/" />
  </head>
  <body class="watch-body">
    <a class="watch-skip" href="#dashboard">{en ? 'Skip to dashboard' : '跳至数据面板'}</a>
    <header class="watch-header">
      <nav class="watch-nav" aria-label={en ? 'Market Watch navigation' : '市场监控导航'}>
        <a class="watch-brand" href={en ? '/en/' : '/'} aria-label={t.home}>
          <img src="/acfc-logo.png" width="44" height="44" alt="" />
          <span>ACFC<small>MARKET WATCH</small></span>
        </a>
        <div class="watch-nav-actions">
          <a href={en ? '/en/' : '/'}>{t.home}</a>
          <a class="language-switch" href={en ? '/market-watch/' : '/en/market-watch/'}>{t.language} ↗</a>
        </div>
      </nav>
    </header>

    <main id="dashboard" class="watch-shell">
      <section class="watch-intro">
        <div>
          <p class="watch-eyebrow">{t.eyebrow}</p>
          <h1>{t.title}<span aria-hidden="true">/</span></h1>
          <p>{t.subtitle}</p>
        </div>
        <div class="system-block" aria-label={t.online}>
          <span class="system-dot"></span><strong>{t.online}</strong><small>{t.updated}</small>
        </div>
      </section>

      <div class="section-label"><span>01</span><h2>{t.pulse}</h2><div></div></div>
      <div class="top-indicator-grid">
      <article class="panel fear-greed-panel">
        <div class="panel-heading">
          <div><span class="panel-kicker">CNN / MARKET SENTIMENT</span><h2>{t.fearTitle}</h2><p>{t.fearSub}</p></div>
          <div class="fear-source"><span class:list={{ stale: cnn.stale }}>{cnn.stale ? t.lastGood : t.daily}</span><a href={cnn.sourceUrl} target="_blank" rel="noreferrer">CNN ↗</a></div>
        </div>
        <div class="fear-layout">
