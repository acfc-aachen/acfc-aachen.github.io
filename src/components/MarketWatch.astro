---
import '../styles/global.css';
import marketData from '../data/market-watch.json';

const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const canonical = `https://acfc-aachen.github.io${en ? '/en/market-watch/' : '/market-watch/'}`;
const cnn = marketData.cnn ?? {};
const macro = marketData.macro ?? {};
const t = en ? {
  home:'Back to ACFC', language:'中文', eyebrow:'ACFC / VERIFIED DATA', title:'Market Watch',
  subtitle:'A focused view of market sentiment and the real macro environment — without placeholder indicators.',
  online:'DAILY CHECK ACTIVE', updated:'Sources are checked every day', sentiment:'Market sentiment',
  fearTitle:'Fear & Greed Index', fearSub:'CNN market sentiment · latest available reading', daily:'DAILY DATA', lastGood:'LAST GOOD DATA',
  history:'60-session history', asOf:'As of', extremeFear:'Extreme fear', extremeGreed:'Extreme greed',
  macroKicker:'EUROSTAT / EURO AREA', macroTitle:'Market environment map', macroSub:'Real growth and inflation data · not a forecast',
  macroCurrent:'Current environment', growth:'Real GDP growth', inflation:'HICP inflation', growthUnit:'quarter on quarter', inflationUnit:'year on year',
  contraction:'CONTRACTION', expansion:'EXPANSION', lowerInflation:'LOWER INFLATION', higherInflation:'HIGHER INFLATION', target:'ECB 2% reference',
  methodTitle:'How the map works', method:'The horizontal axis is seasonally and calendar-adjusted real GDP growth versus the previous quarter. The vertical axis is annual HICP inflation. The dot moves only when Eurostat publishes or revises an observation.',
  automationTitle:'Automatic updates', automation:'GitHub Actions checks CNN and Eurostat every day. New releases are deployed automatically; if a source is temporarily unavailable, the last successful observation remains visible and is marked as stale.',
  source:'Source', dataPeriod:'Data period', footer:'ACFC Market Watch · Verified public data', legal:'Not investment advice',
} : {
  home:'返回 ACFC', language:'EN', eyebrow:'ACFC / VERIFIED DATA', title:'市场监控',
  subtitle:'只保留可核验的数据：市场情绪，以及真实的宏观经济环境。',
  online:'每日检查已启用', updated:'系统每天检查数据源', sentiment:'市场情绪',
  fearTitle:'恐慌与贪婪指数', fearSub:'CNN 市场情绪 · 最近可用读数', daily:'每日数据', lastGood:'最近有效数据',
  history:'近 60 个交易日', asOf:'数据时间', extremeFear:'极度恐慌', extremeGreed:'极度贪婪',
  macroKicker:'EUROSTAT / EURO AREA', macroTitle:'市场环境地图', macroSub:'真实增长与通胀数据 · 不是预测模型',
  macroCurrent:'当前环境', growth:'实际 GDP 增长', inflation:'HICP 通胀', growthUnit:'环比', inflationUnit:'同比',
  contraction:'经济收缩', expansion:'经济扩张', lowerInflation:'低通胀', higherInflation:'高通胀', target:'ECB 2% 参考线',
  methodTitle:'地图如何计算', method:'横轴为经季节和日历调整后的实际 GDP 季度环比；纵轴为 HICP 年度通胀率。只有 Eurostat 发布或修订数据时，地图位置才会变化。',
  automationTitle:'如何保证自动更新', automation:'GitHub Actions 每天检查 CNN 与 Eurostat。发现新数据后自动重新发布；如果数据源暂时不可用，则保留最近一次成功数据并标记为过期。',
  source:'来源', dataPeriod:'统计期', footer:'ACFC Market Watch · 可核验公开数据', legal:'不构成投资建议',
};

const fearScore = cnn.available && cnn.score !== null ? Number(cnn.score) : null;
const fearRatingLabels: Record<string,string> = en ? {
  'extreme fear':'Extreme fear', fear:'Fear', neutral:'Neutral', greed:'Greed', 'extreme greed':'Extreme greed',
} : {
  'extreme fear':'极度恐慌', fear:'恐慌', neutral:'中性', greed:'贪婪', 'extreme greed':'极度贪婪',
};
const fearRating = fearRatingLabels[cnn.rating] ?? (en ? 'Unavailable' : '暂无数据');
const fearColor = fearScore === null ? '#8a96a6' : fearScore < 25 ? '#d84e66' : fearScore < 45 ? '#d98532' : fearScore < 55 ? '#7b8797' : fearScore < 75 ? '#3a9f78' : '#16865c';
const fearHistory = (cnn.history ?? []).slice(-60);
const fearWidth = 620;
const fearHeight = 150;
const fearPath = fearHistory.map((point, index) => {
  const x = fearHistory.length > 1 ? index / (fearHistory.length - 1) * fearWidth : 0;
  const y = fearHeight - Number(point.value) / 100 * fearHeight;
  return `${index === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join(' ');
const fearArea = fearPath ? `${fearPath} L${fearWidth} ${fearHeight} L0 ${fearHeight} Z` : '';
const fearAsOf = cnn.asOf ? new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { dateStyle:'medium', timeStyle:'short', timeZone:'Europe/Berlin' }).format(new Date(cnn.asOf)) : '—';
const comparison = en ? [
  ['Previous close',cnn.previousClose],['One week ago',cnn.previousWeek],['One month ago',cnn.previousMonth],['One year ago',cnn.previousYear],
] : [
  ['前一收盘日',cnn.previousClose],['一周前',cnn.previousWeek],['一个月前',cnn.previousMonth],['一年前',cnn.previousYear],
];
const growthValue = macro.available ? Number(macro.growth?.value) : null;
const inflationValue = macro.available ? Number(macro.inflation?.value) : null;
const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
const macroX = growthValue === null ? 50 : clamp((growthValue + 1) / 2 * 100, 5, 95);
const macroY = inflationValue === null ? 50 : clamp((1 - inflationValue / 6) * 100, 5, 95);
const macroLabel = growthValue === null || inflationValue === null ? (en ? 'Data unavailable' : '暂无数据')
  : growthValue >= 0 && inflationValue > 2 ? (en ? 'Expansion · inflation above target' : '经济扩张 · 通胀高于目标')
  : growthValue >= 0 ? (en ? 'Expansion · lower inflation' : '经济扩张 · 通胀较低')
  : inflationValue > 2 ? (en ? 'Contraction · inflation above target' : '经济收缩 · 通胀高于目标')
  : (en ? 'Contraction · lower inflation' : '经济收缩 · 通胀较低');
---
<!doctype html>
<html lang={en ? 'en' : 'zh-CN'} class="watch-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en ? 'Market Watch — ACFC' : '市场监控 Market Watch — ACFC'}</title>
    <meta name="description" content={t.subtitle} />
    <meta name="theme-color" content="#f5f5f3" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href="https://acfc-aachen.github.io/market-watch/" />
    <link rel="alternate" hreflang="en" href="https://acfc-aachen.github.io/en/market-watch/" />
    <link rel="alternate" hreflang="x-default" href="https://acfc-aachen.github.io/market-watch/" />
  </head>
  <body class="watch-body">
    <a class="watch-skip" href="#dashboard">{en ? 'Skip to dashboard' : '跳至数据面板'}</a>
    <header class="watch-header">
      <nav class="watch-nav" aria-label={en ? 'Market Watch navigation' : '市场监控导航'}>
        <a class="watch-brand" href={en ? '/en/' : '/'} aria-label={t.home}>
          <img src="/acfc-logo.png" width="44" height="44" alt="" />
          <span>ACFC<small>MARKET WATCH</small></span>
        </a>
        <div class="watch-nav-actions">
          <a href={en ? '/en/' : '/'}>{t.home}</a>
          <a class="language-switch" href={en ? '/market-watch/' : '/en/market-watch/'}>{t.language} ↗</a>
        </div>
      </nav>
    </header>

    <main id="dashboard" class="watch-shell">
      <section class="watch-intro">
        <div>
          <p class="watch-eyebrow">{t.eyebrow}</p>
          <h1>{t.title}<span aria-hidden="true">/</span></h1>
          <p>{t.subtitle}</p>
        </div>
        <div class="system-block" aria-label={t.online}>
          <span class="system-dot"></span><strong>{t.online}</strong><small>{t.updated}</small>
        </div>
      </section>

      <div class="section-label"><span>01</span><h2>{t.sentiment}</h2><div></div></div>

      <article class="panel fear-greed-panel">
        <div class="panel-heading">
          <div><span class="panel-kicker">CNN / MARKET SENTIMENT</span><h2>{t.fearTitle}</h2><p>{t.fearSub}</p></div>
          <div class="fear-source"><span class:list={{ stale: cnn.stale }}>{cnn.stale ? t.lastGood : t.daily}</span><a href={cnn.sourceUrl} target="_blank" rel="noreferrer">CNN ↗</a></div>
        </div>
        <div class="fear-layout">
          <div class="fear-gauge" style={`--fear-score:${fearScore ?? 0};--fear-color:${fearColor}`}>
            <div><strong>{fearScore?.toFixed(1) ?? '—'}</strong><span>{fearRating}</span></div>
          </div>
          <div class="fear-scale" aria-hidden="true"><span>{t.extremeFear}</span><i></i><span>{t.extremeGreed}</span></div>
          <div class="fear-history">
            <div class="fear-history-top"><span>{t.history}</span><small>{t.asOf} · {fearAsOf}</small></div>
            {fearPath ? <svg viewBox={`0 0 ${fearWidth} ${fearHeight}`} preserveAspectRatio="none" role="img" aria-label={en ? 'CNN Fear and Greed history' : 'CNN 恐慌与贪婪指数历史走势'}><defs><linearGradient id="fear-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={fearColor} stop-opacity=".24"/><stop offset="1" stop-color={fearColor} stop-opacity="0"/></linearGradient></defs><line x1="0" y1="75" x2={fearWidth} y2="75"/><path class="fear-area" d={fearArea}/><path class="fear-line" d={fearPath} style={`stroke:${fearColor}`}/></svg> : <div class="fear-unavailable">{en ? 'Sentiment data is temporarily unavailable.' : '市场情绪数据暂时不可用。'}</div>}
          </div>
          <div class="fear-comparison">{comparison.map(([label,value]) => <div><span>{label}</span><strong>{value === null ? '—' : Number(value).toFixed(1)}</strong></div>)}</div>
        </div>
        <p class="fear-caption">{en ? 'Source: CNN Fear & Greed Index. The endpoint is not a formally documented public API; the last successful reading remains visible if a refresh fails.' : '数据来源：CNN Fear & Greed Index。该接口并非正式公开 API；如果某次更新失败，页面会继续显示最近一次成功数据。'}</p>
      </article>

      <div class="section-label macro-label"><span>02</span><h2>{en ? 'Macro environment' : '宏观环境'}</h2><div></div></div>
      <article class="panel macro-panel">
        <div class="panel-heading">
          <div><span class="panel-kicker">{t.macroKicker}</span><h2>{t.macroTitle}</h2><p>{t.macroSub}</p></div>
          <div class="fear-source"><span class:list={{ stale: macro.stale }}>{macro.stale ? t.lastGood : t.daily}</span><a href={macro.sourceUrl} target="_blank" rel="noreferrer">EUROSTAT ↗</a></div>
        </div>
        <div class="macro-layout">
          <div class="environment-map" role="img" aria-label={`${t.macroTitle}: ${macroLabel}`}>
            <div class="map-zone upper-left"></div><div class="map-zone upper-right"></div><div class="map-zone lower-left"></div><div class="map-zone lower-right"></div>
            <div class="zero-line"></div><div class="target-line"><span>{t.target}</span></div>
            <span class="map-y top">{t.higherInflation}</span><span class="map-y bottom">{t.lowerInflation}</span>
            <span class="map-x left">{t.contraction}</span><span class="map-x right">{t.expansion}</span>
            {macro.available && <div class="environment-dot" style={`left:${macroX}%;top:${macroY}%`}><i></i><strong>EA21</strong></div>}
          </div>
          <div class="macro-readout">
            <span class="readout-label">{t.macroCurrent}</span><h3>{macroLabel}</h3>
            <div class="macro-metrics">
              <div><span>{t.growth}</span><strong>{growthValue === null ? '—' : `${growthValue > 0 ? '+' : ''}${growthValue.toFixed(1)}%`}</strong><small>{t.growthUnit} · {macro.growth?.period ?? '—'}</small></div>
              <div><span>{t.inflation}</span><strong>{inflationValue === null ? '—' : `${inflationValue.toFixed(1)}%`}</strong><small>{t.inflationUnit} · {macro.inflation?.period ?? '—'}</small></div>
            </div>
            <div class="source-list">
              <a href={macro.sourceUrl} target="_blank" rel="noreferrer"><span>GDP · namq_10_gdp</span><em>Eurostat ↗</em></a>
              <a href={macro.inflationSourceUrl} target="_blank" rel="noreferrer"><span>HICP · prc_hicp_minr</span><em>Eurostat ↗</em></a>
            </div>
          </div>
        </div>
        <div class="method-grid">
          <div><span>01</span><h3>{t.methodTitle}</h3><p>{t.method}</p></div>
          <div><span>02</span><h3>{t.automationTitle}</h3><p>{t.automation}</p></div>
        </div>
      </article>
    </main>

    <footer class="watch-footer"><span>{t.footer}</span><span>{t.legal}</span></footer>

  </body>
</html>

<style is:global>
  :root{--watch-bg:#f5f5f3;--watch-panel:#ffffff;--watch-panel-2:#f0f6fc;--watch-line:#dbe3eb;--watch-text:#102d49;--watch-muted:#68788a;--watch-cyan:#0071e3;--watch-blue:#3867d6;--watch-green:#21966f;--watch-amber:#cf862c;--watch-red:#d34d63;--watch-violet:#8253bb}
  .watch-page{background:var(--watch-bg);color:var(--watch-text);color-scheme:light;scroll-padding-top:82px}
  .watch-body{margin:0;background:radial-gradient(circle at 74% -10%,rgba(0,113,227,.11),transparent 34%),linear-gradient(#f8fafc,#f5f5f3 580px);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;min-height:100vh}
  .watch-body *{box-sizing:border-box}.watch-body a{color:inherit;text-decoration:none}.watch-skip{position:fixed;left:20px;top:-100px;z-index:50;background:#102d49;color:#fff;padding:12px 16px}.watch-skip:focus{top:10px}
  .watch-header{position:sticky;top:0;z-index:20;border-bottom:1px solid rgba(16,45,73,.11);background:rgba(255,255,255,.9);backdrop-filter:blur(18px)}
  .watch-nav{height:72px;width:min(1440px,calc(100% - 48px));margin:auto;display:flex;align-items:center;justify-content:space-between}.watch-brand{display:flex;align-items:center;gap:12px;font-size:20px;font-weight:750;letter-spacing:-.6px}.watch-brand img{object-fit:contain}.watch-brand small{display:block;color:var(--watch-muted);font-size:8px;letter-spacing:2.2px;margin-top:2px}.watch-nav-actions{display:flex;align-items:center;gap:28px;font-size:12px;color:var(--watch-muted)}.watch-nav-actions a:hover{color:var(--watch-text)}.language-switch{border:1px solid var(--watch-line);border-radius:999px;padding:9px 13px}
  .watch-shell{width:min(1440px,calc(100% - 48px));margin:auto;padding:52px 0 80px}.watch-intro{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:32px}.watch-eyebrow,.panel-kicker{margin:0 0 14px;color:var(--watch-cyan);font-size:10px;letter-spacing:2.2px;font-weight:700}.watch-intro h1{margin:0;font-size:clamp(46px,6vw,84px);line-height:.95;letter-spacing:-4px;font-weight:680}.watch-intro h1 span{color:var(--watch-cyan);margin-left:8px}.watch-intro>div>p:last-child{color:var(--watch-muted);font-size:15px;max-width:620px;margin:25px 0 0}.system-block{display:grid;grid-template-columns:10px auto;column-gap:10px;align-items:center;text-align:right}.system-dot{width:8px;height:8px;border-radius:50%;background:var(--watch-green);box-shadow:0 0 12px rgba(33,150,111,.45)}.system-block strong{font-size:11px;letter-spacing:1.4px}.system-block small{grid-column:2;color:var(--watch-muted);font-size:10px;margin-top:5px}.demo-banner{display:flex;align-items:center;gap:16px;border:1px solid rgba(207,134,44,.28);background:#fff8ed;padding:11px 15px;border-radius:5px;color:#82613d;font-size:11px}.demo-banner strong{color:var(--watch-amber);font-size:9px;letter-spacing:1.5px;border:1px solid rgba(207,134,44,.35);border-radius:3px;padding:4px 6px}
  .ticker-rail{margin:18px 0 45px;border-block:1px solid var(--watch-line);display:flex;overflow-x:auto;scrollbar-width:none}.ticker{min-width:210px;flex:1;display:grid;grid-template-columns:1fr auto;gap:5px 12px;padding:16px 18px;border-right:1px solid var(--watch-line)}.ticker:first-child{padding-left:0}.ticker:last-child{border:0}.ticker span{grid-column:1/-1;color:var(--watch-muted);font-size:9px;letter-spacing:1.5px}.ticker strong{font-size:17px}.ticker em{font-size:11px;font-style:normal;align-self:end}.up{color:var(--watch-green)}.down{color:var(--watch-red)}.warn{color:var(--watch-amber)}.neutral{color:var(--watch-muted)}
  .section-label{display:grid;grid-template-columns:auto auto 1fr;align-items:center;gap:12px;margin-bottom:15px}.section-label span{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--watch-cyan);font-size:10px}.section-label h2{font-size:12px;letter-spacing:1.2px;text-transform:uppercase;margin:0}.section-label div{height:1px;background:var(--watch-line)}
  .panel{background:linear-gradient(145deg,#fff,#f8fbff);border:1px solid var(--watch-line);border-radius:8px;box-shadow:0 18px 44px rgba(25,63,101,.07)}.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:14px}.kpi{padding:18px 18px 12px;overflow:hidden;position:relative}.panel-top{display:flex;justify-content:space-between;color:var(--watch-muted);font-size:10px;letter-spacing:.6px}.live-mark{font-size:8px;border:1px solid var(--watch-line);padding:3px 5px;border-radius:2px}.kpi-reading{display:flex;align-items:baseline;gap:8px;margin-top:15px}.kpi-reading strong{font-size:34px;letter-spacing:-1.5px}.kpi-reading small{color:var(--watch-muted);font-size:10px}.kpi-reading em{font-size:10px;font-style:normal;margin-left:auto;color:var(--watch-cyan)}.spark{width:100%;height:42px;margin-top:9px;overflow:visible}.spark path{fill:none;stroke:currentColor;stroke-width:2}.kpi.cyan{color:var(--watch-cyan)}.kpi.blue{color:var(--watch-blue)}.kpi.green{color:var(--watch-green)}.kpi.amber{color:var(--watch-amber)}.kpi .panel-top,.kpi .kpi-reading strong{color:var(--watch-text)}
