ke:var(--watch-line);stroke-width:1;stroke-dasharray:4 5}.fear-area{fill:url(#fear-fill)}.fear-line{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}.fear-unavailable{display:grid;place-items:center;height:180px;border:1px dashed var(--watch-line);color:var(--watch-muted);font-size:11px}.fear-comparison{display:grid;gap:0;border:1px solid var(--watch-line);border-radius:5px;overflow:hidden}.fear-comparison div{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px;border-bottom:1px solid var(--watch-line)}.fear-comparison div:last-child{border:0}.fear-comparison span{color:var(--watch-muted);font-size:9px}.fear-comparison strong{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px}.fear-caption{margin:18px 0 0;color:var(--watch-muted);font-size:9px;line-height:1.65}
